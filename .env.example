# ─── Telegram ───────────────────────────────────────────────
# BotFather dan olingan bot token
BOT_TOKEN=8208868469:AAG05uhaIu2gh9qRRVKrxGltIG72sfGkCoA

# Yagona Super Admin Telegram User ID
ADMIN_ID=7647382204

# ─── Database (MySQL) ────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ig_checker
DB_USER=root
DB_PASS=

# ─── Proxy (ixtiyoriy) ───────────────────────────────────────
# DataImpulse yoki boshqa rotating residential proxy URL.
# Bo'sh qoldirilsa, to'g'ridan-to'g'ri (direct) ulanish ishlatiladi.
# Format: http://user:password@host:port
#         socks5://user:password@host:port
# PROXY_URL= 
PROXY_URL=http://3796663a059d5e8762d2__cr.us:e0a68eea892e58fd@gw.dataimpulse.com:823




# ─── Checker Sozlamalari ─────────────────────────────────────
# Proxysiz rejimdagi so'rovlar orasidagi minimum kechikish (soniya)
CHECK_DELAY_MIN=1.5

# Proxysiz rejimdagi so'rovlar orasidagi maksimum kechikish (soniya)
CHECK_DELAY_MAX=3.5

# Proxy bilan parallel concurrent request soni
CONCURRENT_LIMIT_PROXY=6

# Proxysiz parallel concurrent request soni
CONCURRENT_LIMIT_DIRECT=2

# 429 (rate-limit) da kutish vaqti (soniya)
RATE_LIMIT_SLEEP=30

# ─── Generator Sozlamalari ───────────────────────────────────
# Random username generatsiyasida ishlatiladigan belgilar to'plami
# Qiymatlar: letters | alphanumeric | alphanumeric_underscore
GENERATOR_CHARSET=alphanumeric

# Default generatsiya soni (foydalanuvchi ko'rsatmasa)
GENERATOR_DEFAULT_COUNT=20

# ─── Bulk Check ──────────────────────────────────────────────
# Bir sessiyada tekshirilishi mumkin bo'lgan maksimum username soni
BULK_MAX_USERNAMES=100
